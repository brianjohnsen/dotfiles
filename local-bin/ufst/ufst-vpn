#!/bin/bash
# UFST/SKAT VPN — toggle
#
#   ufst-vpn op | ned | status
#
# Kodeordet ligger i ~/.ufst-password (mode 600), uden for dette repo.
# Det sendes til openconnect via stdin (--passwd-on-stdin), ikke som
# argument — så det er ikke synligt i `ps` for andre brugere på maskinen.

set -uo pipefail

VPN_USER=W93402
VPN_HOST=hap.skat.dk

# UFST's interne DNS-server. Bruges kun af `status` til at advare hvis
# /etc/resolv.conf er blevet overskrevet midt i en session.
VPN_DNS=172.31.31.31

# Chrome-PWA'er der hører til UFST-arbejdet. Startes og lukkes kun med --apps.
#
# Nøglen er Chrome's app-id. Den optræder to steder: i .desktop-filens navn
# (~/.local/share/applications/chrome-<id>-Default.desktop) og som vinduets
# WM_CLASS (crx_<id>). Begge bruges nedenfor.
# Rækkefølgen er bevidst: start_apps åbner dem oppefra og ned, og den sidste
# ender øverst. Teams skal ligge forrest, så den står nederst her.
UFST_APPS=(
    "Outlook:eoficlgicibekocmfdomjbfnjmehnhcd"
    "Teams:ompifgpmddkgmclendfeacglnodjjndh"
)

# Kodeord og TOTP-seed ligger uden for repoet, så de aldrig kan committes.
# Filen sources som ren shell og skal sætte VPN_PASSWORD og VPN_TOTP_SECRET.
# Sæt UFST_PASSWORD_FILE for at pege et andet sted hen.
UFST_PASSWORD_FIL="${UFST_PASSWORD_FILE:-$HOME/.ufst-password}"

if [[ ! -r $UFST_PASSWORD_FIL ]]; then
    cat >&2 <<FEJL
Mangler $UFST_PASSWORD_FIL

Opret den sådan her (umask 077 giver den mode 600 med det samme):

    umask 077
    cat > $UFST_PASSWORD_FIL <<'FIL'
VPN_PASSWORD='dit-kodeord'
VPN_TOTP_SECRET=''
FIL

VPN_TOTP_SECRET er base32-seed'en fra Microsoft Authenticator. Lad den
være tom hvis du ikke har en — så spørger scriptet om MFA-koden i stedet.
FEJL
    exit 1
fi

# shellcheck source=/dev/null
source "$UFST_PASSWORD_FIL"

: "${VPN_PASSWORD:?er ikke sat i $UFST_PASSWORD_FIL}"
VPN_TOTP_SECRET="${VPN_TOTP_SECRET:-}"

usage() {
    local navne
    navne=$(IFS=,; echo "${UFST_APPS[*]%%:*}")
    navne=${navne//,/, }

    cat <<EOF
Brug: ufst-vpn {op|ned|status} [--apps] [--interaktiv]

  op      Forbind til $VPN_HOST som $VPN_USER
  ned     Afbryd pænt (SIGINT — så vpnc-script når at rydde ruter og DNS op)
  status  Vis tunnelens tilstand: adresse, ruter, DNS

  --apps         Start (op) eller luk (ned) UFST-PWA'erne: $navne.
                 Uden flaget røres ingen vinduer.
  --interaktiv   Tast selv både kodeord og MFA-kode (fallback hvis den
                 automatiske indfødning driller)

Kodeord og TOTP-seed læses fra ~/.ufst-password. Uden en seed skal den
6-cifrede MFA-kode tastes ved hvert login.
EOF
}

is_up() { pgrep -x openconnect >/dev/null 2>&1; }

vent_på() {
    # vent_på <betingelse-kommando> <sekunder>
    local i
    for ((i = 0; i < $2; i++)); do
        eval "$1" && return 0
        sleep 1
    done
    return 1
}

# Vindues-id'er for en PWA. Chrome starter ikke en proces pr. PWA — en
# `--app-id`-kommando afleverer bare startordren til den kørende browser og
# dør igen. Derfor er der intet at pgrep'e efter; vinduets WM_CLASS er det
# eneste håndtag på en enkelt PWA.
#
# BEMÆRK --classname, ikke --class. En PWA's WM_CLASS er parret
# ("crx_<app-id>", "Google-chrome"), og xdotool's --class matcher det ANDET
# felt — som alle Chrome-vinduer deler. --class "crx_..." finder derfor
# ingenting, og --class Chrome ville ramme hele browseren. Ankrene sikrer at
# app-id'et matches præcist og ikke som delstreng.
app_vinduer() {
    xdotool search --classname "^crx_$1\$" 2>/dev/null
}

har_xdotool() {
    if ! command -v xdotool >/dev/null 2>&1; then
        echo "  xdotool mangler — kan ikke håndtere PWA-vinduer (apt install xdotool)" >&2
        return 1
    fi
}

start_apps() {
    har_xdotool || return 0

    local app navn id
    for app in "${UFST_APPS[@]}"; do
        navn=${app%%:*}
        id=${app#*:}

        if [[ -n $(app_vinduer "$id") ]]; then
            echo "» $navn kører allerede"
            continue
        fi

        # gtk-launch tager .desktop-filens id uden endelsen. Afkoblet, fordi
        # den bliver hængende så længe appen lever.
        gtk-launch "chrome-${id}-Default" >/dev/null 2>&1 &
        echo "» starter $navn"

        # Vent på vinduet før næste app startes. Uden det er begge launches i
        # luften samtidig, og hvem der ender øverst bliver et kapløb — så
        # rækkefølgen i UFST_APPS ville ikke betyde noget. En timeout advarer
        # kun; så blokerer én app der driller ikke de andre.
        vent_på "[[ -n \$(app_vinduer $id) ]]" 30 \
            || echo "  $navn kom ikke op inden for 30s" >&2
    done
}

# Lukker ét vindue med Chromes luk-genvej. Returnerer 0 når vinduet faktisk
# er væk.
#
# Fyr ALDRIG tasten uden bekræftet input-fokus. `xdotool key` går via XTEST
# til det vindue der har fokus i netop det øjeblik, og ctrl+shift+w i et
# forkert Chrome-vindue lukker det vindue med alle dets faner.
# `windowactivate --sync` venter kun på WM'ens _NET_ACTIVE_WINDOW; Chrome
# tager tastatur-fokus et øjeblik senere, og det hul er nok til at ramme
# forbi. (--window kan ikke bruges i stedet: den vej sender XSendEvent, og
# Chrome smider syntetiske events med det flag væk.)
#
# Selv med fokus på plads bliver tasten indimellem ikke omsat til en lukning
# — set på både Teams og Outlook, oftest lige efter at vinduet er åbnet. Så
# tre forsøg, og først derefter en fejl.
luk_vindue() {
    local wid=$1

    for _ in 1 2 3; do
        findes "$wid" || return 0

        xdotool windowactivate --sync "$wid" 2>/dev/null || return 1
        vent_på "[[ \$(xdotool getwindowfocus 2>/dev/null) == $wid ]]" 5 || return 1

        xdotool key --clearmodifiers ctrl+shift+w
        vent_på "! findes $wid" 3 && return 0
    done

    return 1
}

findes() { xdotool getwindowname "$1" >/dev/null 2>&1; }

# Lukning sker med Chromes EGEN luk-genvej, ikke med `xdotool windowclose`.
# Det er ikke en smagssag: windowclose sender WM_DELETE_WINDOW, og på det
# signal fjerner Chrome kun vinduet — appen bliver hængende i en tilstand
# hvor et nyt `--app-id`-kald bare bliver slugt (rc=0, "Åbner i eksisterende
# browsersession", intet vindue). Teams kunne derefter først åbnes igen efter
# en fuld genstart af Chrome. Verificeret: windowclose → kan ikke genåbnes,
# ctrl+shift+w → kan genåbnes med det samme, i flere runder for begge apps.
#
# Prisen er at vinduet skal have fokus for at kunne modtage tasten, så
# fokus gemmes og gives tilbage bagefter — samme mønster som
# bin/reload-chrome.sh.
luk_apps() {
    har_xdotool || return 0

    local app navn id wid oprindeligt
    oprindeligt=$(xdotool getactivewindow 2>/dev/null)

    for app in "${UFST_APPS[@]}"; do
        navn=${app%%:*}
        id=${app#*:}

        for wid in $(app_vinduer "$id"); do
            if luk_vindue "$wid"; then
                echo "» lukker $navn"
            else
                echo "  $navn lukkede ikke" >&2
            fi
        done
    done

    [[ -n $oprindeligt ]] && xdotool windowactivate --sync "$oprindeligt" 2>/dev/null
    return 0
}

cmd_status() {
    if ! is_up; then
        echo "VPN: NEDE"
        echo "  default-rute: $(ip route show default | head -1)"
        return 1
    fi

    echo "VPN: OPPE (pid $(pgrep -x openconnect | tr '\n' ' '))"
    if ip link show tun0 >/dev/null 2>&1; then
        echo "  adresse:"
        ip -br addr show tun0 | sed 's/^/    /'
        echo "  ruter:"
        ip route show dev tun0 2>/dev/null | sed 's/^/    /'
        echo "  DNS:"
        # vpnc-script registrerer ikke tun0 som et systemd-resolved-link; den
        # skriver direkte i /etc/resolv.conf. `resolvectl status tun0` er derfor
        # altid tom og siger intet om hvorvidt DNS faktisk virker.
        grep -E '^(nameserver|search|domain)' /etc/resolv.conf | sed 's/^/    /'

        if ! grep -q "^nameserver $VPN_DNS\$" /etc/resolv.conf; then
            echo "    ADVARSEL: UFST's DNS ($VPN_DNS) står ikke i /etc/resolv.conf."
            echo "    Interne navne resolver ikke. systemd-resolved har sandsynligvis"
            echo "    regenereret filen midt i sessionen. Ret det med:  ufst-ned && ufst-op"
        fi
    else
        echo "  ADVARSEL: openconnect kører, men tun0 findes ikke"
    fi
}

cmd_op() {
    local interaktiv="" apps="" arg
    for arg in "$@"; do
        case $arg in
            --interaktiv) interaktiv=1 ;;
            --apps)       apps=1 ;;
            *) echo "Ukendt flag til op: $arg" >&2; return 2 ;;
        esac
    done

    if is_up; then
        echo "VPN kører allerede."
        cmd_status
        [[ -n $apps ]] && start_apps
        return 0
    fi

    # Godkend sudo FØRST. Ellers kommer fingeraftryks-prompten efter at
    # MFA-koden er tastet, og en langsom godkendelse kan nå at lade den
    # 30-sekunders TOTP-kode udløbe inden den sendes.
    if ! sudo -v; then
        echo "sudo-godkendelse fejlede." >&2
        return 1
    fi

    local args=(
        --background
        --useragent=AnyConnect
        --protocol=anyconnect
        --user="$VPN_USER"
    )
    # BEMÆRK: --no-external-auth fra UFST's udleverede kommando er udeladt med
    # vilje. Flaget kom først i openconnect v9.00; på v8.20 giver det
    # "unrecognized option". Det er alligevel et no-op her, da v8.20 aldrig
    # annoncerer SSO-login over for gatewayen.

    # Slå gatewayens adresse op NU, mens DNS stadig virker, og giv den videre.
    #
    # Gatewayen sætter Tunnel-All-DNS, så resolv.conf peger på 172.31.31.31,
    # der kun kan nås gennem tunnelen. Skal openconnect genforbinde undervejs,
    # kan den ikke slå $VPN_HOST op: DNS kræver tunnelen, tunnelen kræver DNS.
    # --resolve bryder den knude uden at hardcode noget, så adressen aldrig
    # kan blive forældet (i modsætning til en linje i /etc/hosts).
    local gateway_ip
    gateway_ip=$(getent ahostsv4 "$VPN_HOST" 2>/dev/null | awk 'NR==1 {print $1}')
    if [[ -n $gateway_ip ]]; then
        args+=(--resolve="$VPN_HOST:$gateway_ip")
        echo "» $VPN_HOST → $gateway_ip"
    else
        echo "  ADVARSEL: kunne ikke slå $VPN_HOST op." >&2
        echo "  Peger /etc/resolv.conf stadig på UFST's DNS efter en uren" >&2
        echo "  afbrydelse? Tjek med: ufst-vpn status" >&2
    fi

    if [[ -n $interaktiv ]]; then
        echo "» Interaktivt login — tast kodeord og MFA-kode."
        sudo openconnect "${args[@]}" "$VPN_HOST" || return 1

    elif [[ -n $VPN_TOTP_SECRET ]]; then
        # Lydløst: kodeord på stdin, MFA-kode genereret lokalt i samme øjeblik
        # formularen sendes. Intet timing-vindue at ramme forbi.
        #
        # openconnect kræver "base32:" foran en base32-hemmelighed. Mangler
        # præfikset, tolkes strengen som rå bytes, og koderne bliver forkerte
        # uden nogen fejl — bare et login der afvises. Sæt det på hvis det
        # ikke allerede står der, så begge skrivemåder virker.
        local seed=$VPN_TOTP_SECRET
        [[ $seed == base32:* ]] || seed="base32:$seed"

        args+=(--passwd-on-stdin --token-mode=totp --token-secret="$seed")
        printf '%s\n' "$VPN_PASSWORD" | sudo openconnect "${args[@]}" "$VPN_HOST" || return 1

    else
        # Kodeord og kode sendes som to linjer på stdin. openconnect læser
        # linje 1 til password-feltet og linje 2 til MFA-feltet.
        #
        # Koden skal være frisk: den er væk fra prompten til den sendes på
        # under et sekund, men er den allerede 25 sekunder gammel når du
        # taster den, når den at udløbe undervejs. Vent på at den skifter.
        echo "» Vent til koden lige har skiftet i Authenticator, og tast den så."
        local kode
        read -rsp "  Microsoft-kode (6 cifre): " kode </dev/tty
        echo
        args+=(--passwd-on-stdin)
        if ! printf '%s\n%s\n' "$VPN_PASSWORD" "$kode" \
            | sudo openconnect "${args[@]}" "$VPN_HOST"
        then
            cat >&2 <<EOF

Login fejlede.

Den hyppigste årsag er at koden nåede at udløbe. TOTP-vinduet er 30
sekunder, og openconnect prøver formularen igen med en tom pipe — det er
det der giver "fgets (stdin)"-fejlen bagefter. Prøv igen med en frisk kode.

Bliver det ved, så test om indfødningen er problemet:

    ufst-op --interaktiv

Varig løsning: sæt VPN_TOTP_SECRET i
$UFST_PASSWORD_FIL
Så genererer openconnect koden selv i samme øjeblik formularen sendes,
og timing-problemet forsvinder helt.
EOF
            return 1
        fi
    fi

    # openconnect forker først til baggrunden når auth er gennemført
    if vent_på 'ip link show tun0 >/dev/null 2>&1' 15; then
        echo
        cmd_status
        # Først nu kan de nå Microsoft gennem tunnelen.
        [[ -n $apps ]] && { echo; start_apps; }
    else
        echo "tun0 kom ikke op inden for 15s." >&2
        return 1
    fi
}

cmd_ned() {
    local apps="" arg
    for arg in "$@"; do
        case $arg in
            --apps) apps=1 ;;
            *) echo "Ukendt flag til ned: $arg" >&2; return 2 ;;
        esac
    done

    # Før tunnelen ryger, så de ikke sidder og hamrer på en forbindelse der
    # er ved at forsvinde. Også hvis VPN'en slet ikke kørte — flaget skal
    # gøre det, det siger.
    [[ -n $apps ]] && luk_apps

    if ! is_up; then
        echo "VPN kører ikke."
        return 0
    fi

    # SIGINT, ikke SIGKILL: så når vpnc-script at rydde ruter og DNS op.
    # (SIGINT får samtidig openconnect til at logge ud hos serveren, så
    # sessionen destrueres — relevant hvis session-genbrug nogensinde
    # skal prøves igen; dér ville SIGTERM være det rigtige.)
    sudo pkill -SIGINT -x openconnect

    if vent_på '! pgrep -x openconnect >/dev/null 2>&1' 10; then
        echo "Afbrudt — ruter og DNS ryddet op."
    else
        echo "openconnect svarer ikke på SIGINT." >&2
        echo "pkill -9 virker, men efterlader ruter og DNS i uorden." >&2
        return 1
    fi
}

case "${1:-}" in
    op)     cmd_op "${@:2}" ;;
    ned)    cmd_ned "${@:2}" ;;
    status) cmd_status ;;
    ""|-h|--help|help) usage ;;
    *)      echo "Ukendt kommando: $1" >&2; echo >&2; usage >&2; exit 2 ;;
esac
